# API Configuration
# URL base da API do backend (sem barra no final)
VITE_API_URL=http://localhost:3000/api/v1

# Rastreamento de erros (Sentry) — opcional. Sem DSN, nada é enviado e o
# pacote nem é carregado. Com DSN, incluir o domínio de ingestão do Sentry
# (ex.: https://*.ingest.us.sentry.io) no connect-src do CSP em vercel.json.
VITE_SENTRY_DSN=
# Opcional: ambiente e versão (ex.: commit) mostrados no Sentry
VITE_SENTRY_ENVIRONMENT=
VITE_RELEASE=

# Suporte (site, páginas legais, "Meu plano") — opcional. Sem env, fica
# suporte@parish.app. WhatsApp: número com DDD (com ou sem 55), só dígitos ou
# com máscara; vazio = sem botão de WhatsApp.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=
